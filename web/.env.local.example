# Copy to .env.local for host-run development (docker-compose sets these
# itself for a containerised frontend, once one exists).
#
# Server-side fetches (Server Components) — never shipped to the browser.
GATEWAY_BASE_URL=http://localhost:8080/api
# Browser-side fetches (the viewer-identity stub, reactions, comments) — must
# be reachable from wherever the browser actually runs, not just the server.
NEXT_PUBLIC_GATEWAY_BASE_URL=http://localhost:8080/api
