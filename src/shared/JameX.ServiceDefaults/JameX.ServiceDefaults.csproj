<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Shared wiring for every service host, so ASP.NET types are needed here. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JameX.Contracts\JameX.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.DynamoDBv2" Version="4.0.103" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.102" />
    <PackageReference Include="AWSSDK.SimpleNotificationService" Version="4.0.100.7" />
    <PackageReference Include="AWSSDK.SQS" Version="4.0.100.7" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.8.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- Pinned: 10.0.10 pulls Microsoft.OpenApi 2.0.0 transitively, which carries
         advisory GHSA-v5pm-xwqc-g5wc. 2.11.0 is the patched same-major release. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.11.0" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.16.18" />
    <PackageReference Include="StackExchange.Redis" Version="3.1.13" />
  </ItemGroup>

</Project>
