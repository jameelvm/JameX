{
  // Host-run defaults; docker-compose overrides these with container addresses.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "ConnectionStrings": {
    "Redis": "localhost:6379"
  },

  "Aws": {
    "ServiceUrl": "http://localhost:4566",
    // Presigned URLs are signed for this address, so it must be what the
    // BROWSER can reach — not what this process can reach. Identical here only
    // because LocalStack is published on the host.
    "PublicServiceUrl": "http://localhost:4566",
    "Region": "us-east-1",
    "AccessKey": "test",
    "SecretKey": "test"
  },

  "Storage": {
    "RawBucket": "jamex-raw",
    "MediaBucket": "jamex-media",
    "CdnBaseUrl": "http://localhost:8090/media"
  },

  "Messaging": {
    "TopicName": "jamex-video-events"
  },

  "Upload": {
    "SessionsTableName": "jamex-upload-sessions"
  }
}
