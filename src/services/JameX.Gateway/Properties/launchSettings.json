{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    // When the Gateway runs here, its cluster destinations come from
    // appsettings.json — which lists BOTH the container's published port and
    // the local debug port for every service, and health-checks them.
    "Gateway (local)": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": false,
      "applicationUrl": "http://localhost:5080",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    }
  }
}
