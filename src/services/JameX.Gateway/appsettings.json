{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",

  "Aws": {
    "ServiceUrl": "http://localhost:4566",
    "PublicServiceUrl": "http://localhost:4566",
    "Region": "us-east-1",
    "AccessKey": "test",
    "SecretKey": "test"
  },
  "Messaging": {
    "TopicName": "jamex-video-events"
  },

  "Services": {
    "Identity": "http://localhost:8081",
    "Catalog": "http://localhost:8082",
    "Ingest": "http://localhost:8083",
    "Engagement": "http://localhost:8084",
    "Search": "http://localhost:8085"
  },

  "ReverseProxy": {
    "Routes": {
      "identity": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/identity/{**catch-all}" }
      },
      "channels": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/channels/{**catch-all}" }
      },
      "uploads": {
        "ClusterId": "ingest",
        "Match": { "Path": "/api/uploads/{**catch-all}" }
      },
      "search": {
        "ClusterId": "search",
        "Match": { "Path": "/api/search/{**catch-all}" }
      },

      "video-comments": {
        "ClusterId": "engagement",
        "Match": { "Path": "/api/videos/{videoId}/comments/{**catch-all}" }
      },
      "video-reactions": {
        "ClusterId": "engagement",
        "Match": { "Path": "/api/videos/{videoId}/reactions/{**catch-all}" }
      },
      "video-engagement": {
        "ClusterId": "engagement",
        "Match": { "Path": "/api/videos/{videoId}/{action:regex(^(views|counts)$)}" }
      },

      "catalog": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/videos/{**catch-all}" }
      }
    },

    "Clusters": {
      "identity":   { "Destinations": { "d1": { "Address": "http://localhost:8081/" } } },
      "catalog":    { "Destinations": { "d1": { "Address": "http://localhost:8082/" } } },
      "ingest":     { "Destinations": { "d1": { "Address": "http://localhost:8083/" } } },
      "engagement": { "Destinations": { "d1": { "Address": "http://localhost:8084/" } } },
      "search":     { "Destinations": { "d1": { "Address": "http://localhost:8085/" } } }
    }
  }
}
