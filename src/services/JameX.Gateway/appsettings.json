{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",

  "Aws": {
    "ServiceUrl": "http://localhost:4566",
    "PublicServiceUrl": "http://localhost:4566",
    "Region": "us-east-1",
    "AccessKey": "test",
    "SecretKey": "test"
  },
  "Messaging": {
    "TopicName": "jamex-video-events"
  },

  "Services": {
    "Identity": "http://localhost:8081",
    "Catalog": "http://localhost:8082",
    "Ingest": "http://localhost:8083",
    "Engagement": "http://localhost:8084",
    "Search": "http://localhost:8085"
  },

  "ReverseProxy": {
    // Every route strips a prefix before forwarding. Without a transform YARP
    // passes the path through unchanged, so /api/videos/{id} would arrive at
    // Catalog as /api/videos/{id} — which matches nothing, and the Gateway
    // returns the service's 404 while looking like it routed correctly.
    //
    // "/api" is the public namespace; services know nothing about it.
    // "/api/identity" collapses to "/users" because Identity owns two
    // top-level resources and only one of them is reachable under that prefix.
    "Routes": {
      "identity": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/identity/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api/identity" } ]
      },
      "users": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/users/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "channels": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/channels/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "uploads": {
        "ClusterId": "ingest",
        "Match": { "Path": "/api/uploads/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "search": {
        "ClusterId": "search",
        "Match": { "Path": "/api/search/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },

      // These three are declared BEFORE the catch-all catalog route because
      // they are more specific: /api/videos/{id}/comments belongs to
      // Engagement, while /api/videos/{id} belongs to Catalog. YARP scores
      // routes by specificity rather than order, but keeping them together
      // makes the split readable.
      "video-comments": {
        "ClusterId": "engagement",
        "Match": { "Path": "/api/videos/{videoId}/comments/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "video-reactions": {
        "ClusterId": "engagement",
        "Match": { "Path": "/api/videos/{videoId}/reactions/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "video-engagement": {
        "ClusterId": "engagement",
        "Match": { "Path": "/api/videos/{videoId}/{action:regex(^(views|counts)$)}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },

      "catalog": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/videos/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      }
    },

    "Clusters": {
      // Every cluster lists TWO destinations: the containerised instance and
      // the one you start in Visual Studio. Active health checks poll
      // /health/live, and YARP only routes to destinations that answer — so
      // whichever is running receives the traffic, with nothing to reconfigure.
      //
      //   docker compose stop catalog     → traffic moves to localhost:5082
      //   docker compose start catalog    → traffic moves back
      //
      // FirstAlphabetical makes the choice deterministic when BOTH are up:
      // "container" sorts before "local", so the container wins and a
      // forgotten local process cannot silently take over.
      //
      // These addresses are for a Gateway running on the host. When the
      // Gateway runs in compose, its environment variables replace them with
      // container names and host.docker.internal.
      "identity": {
        "LoadBalancingPolicy": "FirstAlphabetical",
        "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:05", "Timeout": "00:00:02", "Policy": "ConsecutiveFailures", "Path": "/health/live" } },
        "Metadata": { "ConsecutiveFailuresHealthPolicy.Threshold": "1" },
        "Destinations": {
          "container": { "Address": "http://localhost:8081/" },
          "local":     { "Address": "http://localhost:5081/" }
        }
      },
      "catalog": {
        "LoadBalancingPolicy": "FirstAlphabetical",
        "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:05", "Timeout": "00:00:02", "Policy": "ConsecutiveFailures", "Path": "/health/live" } },
        "Metadata": { "ConsecutiveFailuresHealthPolicy.Threshold": "1" },
        "Destinations": {
          "container": { "Address": "http://localhost:8082/" },
          "local":     { "Address": "http://localhost:5082/" }
        }
      },
      "ingest": {
        "LoadBalancingPolicy": "FirstAlphabetical",
        "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:05", "Timeout": "00:00:02", "Policy": "ConsecutiveFailures", "Path": "/health/live" } },
        "Metadata": { "ConsecutiveFailuresHealthPolicy.Threshold": "1" },
        "Destinations": {
          "container": { "Address": "http://localhost:8083/" },
          "local":     { "Address": "http://localhost:5083/" }
        }
      },
      "engagement": {
        "LoadBalancingPolicy": "FirstAlphabetical",
        "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:05", "Timeout": "00:00:02", "Policy": "ConsecutiveFailures", "Path": "/health/live" } },
        "Metadata": { "ConsecutiveFailuresHealthPolicy.Threshold": "1" },
        "Destinations": {
          "container": { "Address": "http://localhost:8084/" },
          "local":     { "Address": "http://localhost:5084/" }
        }
      },
      "search": {
        "LoadBalancingPolicy": "FirstAlphabetical",
        "HealthCheck": { "Active": { "Enabled": true, "Interval": "00:00:05", "Timeout": "00:00:02", "Policy": "ConsecutiveFailures", "Path": "/health/live" } },
        "Metadata": { "ConsecutiveFailuresHealthPolicy.Threshold": "1" },
        "Destinations": {
          "container": { "Address": "http://localhost:8085/" },
          "local":     { "Address": "http://localhost:5085/" }
        }
      }
    }
  }
}
