{
  // Host-run defaults; docker-compose overrides these with container addresses.
  //
  // NOTE: running Encoder on the host requires FFmpeg and ffprobe to be on
  // PATH. They are baked into the Encoder image but are NOT installed on this
  // machine, so this profile only works after installing FFmpeg. Every other
  // service debugs locally with no extra tooling.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "ConnectionStrings": {
    "Redis": "localhost:6379"
  },

  "Aws": {
    "ServiceUrl": "http://localhost:4566",
    "PublicServiceUrl": "http://localhost:4566",
    "Region": "us-east-1",
    "AccessKey": "test",
    "SecretKey": "test"
  },

  "Storage": {
    "RawBucket": "jamex-raw",
    "MediaBucket": "jamex-media",
    "CdnBaseUrl": "http://localhost:8090/media"
  },

  "Messaging": {
    "TopicName": "jamex-video-events",
    "QueueName": "jamex-encoder-jobs",
    // Transcoding runs long, so the message stays hidden while it works.
    "VisibilityTimeoutSeconds": 900
  },

  "Encoding": {
    "Provider": "FFmpeg",
    // A Windows-friendly scratch path. The container uses /var/jamex/work.
    "WorkDirectory": "C:\\Temp\\jamex-work",
    "FfmpegPath": "ffmpeg",
    "FfprobePath": "ffprobe"
  }
}
