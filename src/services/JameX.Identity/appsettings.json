{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "Identity": "Host=localhost;Database=jamex_users;Username=jamex;Password=jamex",
    "Redis": "localhost:6379"
  },

  "Aws": {
    "ServiceUrl": "http://localhost:4566",
    "PublicServiceUrl": "http://localhost:4566",
    "Region": "us-east-1",
    "AccessKey": "test",
    "SecretKey": "test"
  },

  "Storage": {
    "RawBucket": "jamex-raw",
    "MediaBucket": "jamex-media",
    "CdnBaseUrl": "http://localhost:8090/media"
  },

  "Messaging": {
    "TopicName": "jamex-video-events"
  },

  // Dev-only value, committed the same way Aws:AccessKey/SecretKey above are —
  // it only works against this local compose stack. Must match the Gateway's
  // Jwt section exactly: Identity signs with this key, the Gateway verifies
  // with it. A real deployment overrides this with a real secret and never
  // commits one.
  "Jwt": {
    "Issuer": "JameX.Identity",
    "Audience": "JameX",
    "SigningKey": "dev-only-signing-key-never-use-in-production-3f8a9c2e7b1d4f6a",
    "ExpiryMinutes": 60
  }
}
